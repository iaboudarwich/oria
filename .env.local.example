# Copy to .env.local and fill in your Supabase project values.

# Public (safe to expose in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used to bootstrap orgs/memberships on first sign-in.
# Keep this out of any code that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for OAuth/magic-link redirects AND invite email links.
# Set to your production URL in prod (e.g. https://oria.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode. When unset (production default), demo personas + fixture data
# are hidden: the landing page omits demo links and /demo/* routes redirect
# to /. Set to "1" only when you want to walk someone through the personas.
NEXT_PUBLIC_DEMO_MODE=

# Resend — invite emails. Sign up at https://resend.com,
# create an API key, and verify a sending domain.
# Leave blank in local dev: the invite system still works
# (the owner can copy the link/code from the UI).
RESEND_API_KEY=
# Format: "Oria <invites@your-domain.com>" or just an email address.
# Must be on a domain you've verified in Resend.
RESEND_FROM_EMAIL=

# Anthropic Claude — powers Ask Oria. Get a key at https://console.anthropic.com.
# Leave blank in local dev: Ask Oria still loads and shows a friendly
# "connect Claude" notice instead of crashing.
ANTHROPIC_API_KEY=
# Optional model override for Ask Oria's chat answers.
# Defaults to claude-haiku-4-5-20251001 (fast + cheap).
ANTHROPIC_MODEL=
# Optional model override for the upload extraction pipeline (vision + OCR).
# Defaults to claude-sonnet-4-6 — extraction accuracy matters more than
# latency here. Falls back to ANTHROPIC_MODEL if unset.
ANTHROPIC_EXTRACTION_MODEL=

# OpenAI — powers voice dictation (Whisper transcription)
# Get a key at platform.openai.com
OPENAI_API_KEY=

# Optional model override for typed quick-logs (the type-to-log path on
# Diet / Bills / etc). These are short, plain-language inputs that run
# fine on a cheap model — defaults to claude-haiku-4-5-20251001.
# Falls back to ANTHROPIC_MODEL if unset.
ORIA_TEXT_EXTRACTION_MODEL=

# Python extraction sidecar — handles PDF, DOCX, and Excel parsing.
# Set to the deployed sidecar URL in prod (Railway), or leave blank /
# point at the local container for development. When unreachable the
# server falls back to the Claude-only extraction path.
PYTHON_EXTRACTION_URL=http://localhost:8000
# HMAC secret used to sign requests to the Python sidecar (/extract,
# /embed, /embed-query). Optional in dev — when blank, requests aren't
# signed and the sidecar's require_signature dependency lets them
# through. REQUIRED in production.
ORIA_SIDECAR_SECRET=

# Upstash Redis — backs the content-hash dedup cache
# (lib/cache/dedup.ts) and is the planned host for the burst rate
# limiter. Optional in dev: when blank the dedup cache silently
# degrades to a fresh extraction every time.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — error reporting. The Sentry SDK initializes against these
# from sentry.{client,server,edge}.config.ts. Optional in dev (Sentry
# is a no-op when the DSN is blank). Get DSNs from sentry.io.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Bearer token Vercel sends with /api/cron/* requests. The cron route
# handlers reject requests whose Authorization header doesn't match.
# Generate a long random string; rotate if leaked. Optional in dev.
CRON_SECRET=

# WHOOP — Health connector (recovery, sleep, daily strain/energy).
# Create an app at https://developer.whoop.com and add the redirect
# https://your-domain.com/api/oauth/whoop/callback. Tokens are encrypted at
# rest with TOKEN_ENCRYPTION_KEY (same key as the other connectors). Leave
# blank in dev: WHOOP shows as "coming soon" until both are set.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Web Push (VAPID) keys for PWA push notifications. Generate with
# `npx web-push generate-vapid-keys`. The public key is exposed to the
# browser; the private key is server-only (keep it secret). VAPID_SUBJECT
# is a mailto: or https: contact URL required by the push spec.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
