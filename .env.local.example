# Copy to .env.local and fill in your Supabase project values.

# Public (safe to expose in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used to bootstrap orgs/memberships on first sign-in.
# Keep this out of any code that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for OAuth/magic-link redirects AND invite email links.
# Set to your production URL in prod (e.g. https://oria.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode. When unset (production default), demo personas + fixture data
# are hidden: the landing page omits demo links and /demo/* routes redirect
# to /. Set to "1" only when you want to walk someone through the personas.
NEXT_PUBLIC_DEMO_MODE=

# Resend — invite emails. Sign up at https://resend.com,
# create an API key, and verify a sending domain.
# Leave blank in local dev: the invite system still works
# (the owner can copy the link/code from the UI).
RESEND_API_KEY=
# Format: "Oria <invites@your-domain.com>" or just an email address.
# Must be on a domain you've verified in Resend.
RESEND_FROM_EMAIL=

# Anthropic Claude — powers Ask Oria. Get a key at https://console.anthropic.com.
# Leave blank in local dev: Ask Oria still loads and shows a friendly
# "connect Claude" notice instead of crashing.
ANTHROPIC_API_KEY=
# Optional model override for Ask Oria's chat answers.
# Defaults to claude-haiku-4-5-20251001 (fast + cheap).
ANTHROPIC_MODEL=
# Optional model override for the upload extraction pipeline (vision + OCR).
# Defaults to claude-sonnet-4-6 — extraction accuracy matters more than
# latency here. Falls back to ANTHROPIC_MODEL if unset.
ANTHROPIC_EXTRACTION_MODEL=

# OpenAI — powers voice dictation (Whisper transcription)
# Get a key at platform.openai.com
OPENAI_API_KEY=
